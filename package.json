{
  "name": "@sandsoftwaresolutions/dir-hash",
  "version": "0.1.1",
  "description": "A single fingerprint for a folder and an exact list of what changed: modified, added, removed, renamed.",
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./src/index.d.ts",
        "default": "./src/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "src",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test && node scripts/build-cjs.mjs --check",
    "pack:check": "npm pack --dry-run",
    "build": "node scripts/build-cjs.mjs",
    "prepack": "node scripts/build-cjs.mjs"
  },
  "keywords": [
    "hash",
    "checksum",
    "integrity",
    "directory",
    "manifest"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SandSoftwareSolutions/ss-dir-hash.git"
  },
  "bugs": {
    "url": "https://github.com/SandSoftwareSolutions/ss-dir-hash/issues"
  },
  "homepage": "https://github.com/SandSoftwareSolutions/ss-dir-hash#readme",
  "publishConfig": {
    "access": "public"
  }
}
